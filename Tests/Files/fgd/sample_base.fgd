// Classes the sample is based on

@BaseClass = Targetname
[
	targetname(target_source) : "Name" : : "The name other entities refer to this entity by."
	input Kill(void) : "Removes the entity."
]

@BaseClass color(0 180 0) size(-4 -4 0, 4 4 16) iconsprite("editor/base.vmat") sphere(radius) tags( Base ) = Sized
[
	radius(float) : "Radius" : "64"
	kind(choices) : "Kind" : 0 = [ 0 : "None" 1 : "Some" ]
]

@BaseClass = Uncolored
[
]
