<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RollForward>LatestMajor</RollForward>
    <Description>Source 2 resource viewer</Description>
    <ApplicationIcon>..\Misc\Icons\source2viewer.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <StartupObject>GUI.Program</StartupObject>
    <AssemblyName>Source2Viewer</AssemblyName>
    <PublishSingleFile Condition="'$(Configuration)' != 'Debug'">true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FCTB" Version="2.16.24">
        <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NLayer.NAudioSupport" Version="3.0.0" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="Sigstore" Version="1.0.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\**" />
    <EmbeddedResource Include="..\Misc\Icons\vpk.ico" Link="Utils\vpk.ico" />
    <EmbeddedResource Include="Utils\industrial_sunset_puresky.vtex_c" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Renderer\Renderer2.csproj" />
    <ProjectReference Include="..\ValveResourceFormat\ValveResourceFormat.csproj" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.txt" Link="Utils\THIRD_PARTY_NOTICES.txt" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ValveResourceFormat.Utils" />
    <Using Include="ValveResourceFormat.CompiledShader" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Shaders\" />
  </ItemGroup>
  <ItemGroup>
    <!-- VKTODO: Excluded until they have Vulkan equivalents, see CurrentGlVkTodo.md -->
    <Compile Remove="Types\GLViewers\GLLockScope.cs" />
    <Compile Remove="Types\GLViewers\GLTextureDecoder.cs" />
    <Compile Remove="Types\GLViewers\GLFWSurface.cs" />
    <Compile Remove="Types\PackageViewer\ThumbnailRenderers\ThumbnailMaterialRenderer.cs" />
    <Compile Remove="Types\PackageViewer\ThumbnailRenderers\ThumbnailModelRenderer.cs" />
    <Compile Remove="Types\PackageViewer\ThumbnailRenderers\ThumbnailParticleRenderer.cs" />
    <Compile Remove="Types\PackageViewer\ThumbnailRenderers\ThumbnailSnapshotRenderer.cs" />
  </ItemGroup>
</Project>
