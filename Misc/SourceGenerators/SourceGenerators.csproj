<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source generators used to build ValveResourceFormat projects.</Description>
    <AssemblyName>ValveResourceFormat.SourceGenerators</AssemblyName>
    <RootNamespace>ValveResourceFormat.SourceGenerators</RootNamespace>
    <!-- Analyzers load into the compiler, which only accepts netstandard2.0 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Release tracking is for analyzers that ship in a package, this one only builds our own projects -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
