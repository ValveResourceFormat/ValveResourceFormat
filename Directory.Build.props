<Project>
  <PropertyGroup>
    <!-- The SDK version is pinned in global.json -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Versions are major.minor.patch.build. Release builds pass the build number (and the base when
         the pushed tag is a full version), see .github/workflows/release-build.yml. Local builds are .0 -->
    <ProjectBaseVersion>1.0.0</ProjectBaseVersion>
    <ProjectBuildNumber Condition="'$(ProjectBuildNumber)' == ''">0</ProjectBuildNumber>
    <ProjectVersion>$(ProjectBaseVersion).$(ProjectBuildNumber)</ProjectVersion>
    <DefineConstants Condition="'$(GITHUB_REF_TYPE)' == 'tag'">$(DefineConstants);CI_RELEASE_BUILD</DefineConstants>

    <AssemblyVersion>$(ProjectVersion)</AssemblyVersion>
    <FileVersion>$(ProjectVersion)</FileVersion>
    <Version>$(ProjectVersion)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)/Misc/ValveResourceFormat.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AnalysisMode Condition="'$(Configuration)' == 'Release'">All</AnalysisMode>
    <AnalysisMode Condition="'$(Configuration)' != 'Release'">Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild Condition="'$(Configuration)' == 'Release'">true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>ValveResourceFormat Contributors</Authors>
    <Copyright>Copyright © ValveResourceFormat Contributors</Copyright>
    <RepositoryUrl>https://github.com/ValveResourceFormat/ValveResourceFormat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://s2v.app/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <!-- CA2000 is very slow: https://github.com/dotnet/roslyn-analyzers/issues/4915 -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Numerics" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>
</Project>
