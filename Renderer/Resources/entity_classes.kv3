						{
							value = "1"
							caption = "Precipitation On Listener"
						},
					]
				}
				precipitationSubclass = 
				{
					type = "vdata_choice:scripts/precipitation.vdata"
					sub_type = "scripts/precipitation.vdata"
					long_name = "Precipitation Subclass"
					description = "Which func_precipitation volumes count. Volumes of any other subclass read as no precipitation, as does everything if this is left blank."
					default = "precipitation_rain"
				}
				densityMin = 
				{
					type = "float"
					long_name = "Minimum Density"
					description = "Density that maps to the low end of the output, in the same 0-100 the volume's own Density field uses."
					default = "0"
					metadata = 
					{
						min = "0.0"
						max = "100.0"
					}
				}
				densityMax = 
				{
					type = "float"
					long_name = "Maximum Density"
					description = "Density that maps to the high end of the output. Lower it to make light rain read as full."
					default = "100"
					metadata = 
					{
						min = "0.0"
						max = "100.0"
					}
				}
				densityMapMin = 
				{
					type = "float"
					long_name = "Minimum Density Map Value"
					description = "Value written at minimum density."
					default = "0.0"
				}
				densityMapMax = 
				{
					type = "float"
					long_name = "Maximum Density Map Value"
					description = "Value written at maximum density."
					default = "1.0"
				}
				totalDirections = 
				{
					type = "integer"
					long_name = "Total Ray Directions"
					description = "Rays in the upward cone. More is a finer reading and a longer sweep."
					default = "16"
					metadata = 
					{
						min = "1"
						max = "256"
						enabled = 
						{
							variable = "mode"
							value = "1"
						}
					}
				}
				tracesPerFrame = 
				{
					type = "integer"
					long_name = "Rays Per Think"
					description = "Rays cast per think. At the default of 1 a full sweep takes Total Ray Directions thinks."
					default = "1"
					metadata = 
					{
						enabled = 
						{
							variable = "mode"
							value = "1"
						}
					}
				}
				coneAngle = 
				{
					type = "float"
					long_name = "Cone Half-Angle"
					description = "How far off vertical the shelter test looks, in degrees. Wider counts rain blowing in from the side; 90 is a full hemisphere."
					default = "60.0"
					metadata = 
					{
						min = "1.0"
						max = "90.0"
						enabled = 
						{
							variable = "mode"
							value = "1"
						}
					}
				}
				traceDistance = 
				{
					type = "float"
					long_name = "Trace Distance"
					description = "How far up to look for sky."
					default = "4096.0"
					metadata = 
					{
