				{
					type = "boolean"
					long_name = "Create Nav Obstacle"
					description = "Create a navigation obstacle to assist NPC pathfinding"
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "Open"
					type = "void"
					description = "Move the brush to the end position (starting position + (move direction * move distance))."
