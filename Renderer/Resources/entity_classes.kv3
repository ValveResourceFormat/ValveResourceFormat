				busyactor = 
				{
					type = "choices"
					long_name = "If an Actor is talking..."
					description = "What to do if an actor this scene needs is already talking when this scene is told to start."
					default = "1"
					choices = 
					[
						{
							value = "0"
							caption = "Start immediately"
						},
						{
							value = "1"
