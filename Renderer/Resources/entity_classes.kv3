		{
			name = "snd_opvar_set_dome"
			kind = "point"
			description = "Measures spatial openness via Fibonacci-distributed traces. Sets an opvar based on openness; fewer blocked rays = higher value. Clustering detection amplifies the effect of adjacent open directions."
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "iconsprite"
					arguments = 
					[
						"editor/snd_opvar_set.vmat",
					]
				},
				{
					name = "sphere"
					arguments = 
					[
						"size",
						"250",
						"101",
						"252",
					]
				},
			]
			bases = 
			[
				"Targetname:570",
				"Parentname:570",
				"SndOpvarSetPointBaseAddition2",
				"SndOpvarSetPointBase:570",
			]
			keys = 
			{
				size = 
				{
					type = "float"
					long_name = "Trace Radius"
					description = "Radius of the sphere to trace against."
					default = "512.0"
				}
				totalDirections = 
				{
					type = "integer"
					long_name = "Total Ray Directions"
					description = "Number of Fibonacci-distributed ray directions."
					default = "128"
					metadata = 
					{
						min = "2"
						max = "1024"
					}
				}
				tracesPerFrame = 
				{
					type = "integer"
					long_name = "Rays Per Think"
					description = "Number of rays to evaluate per think frame."
					default = "16"
				}
				domeMode = 
				{
					type = "bool"
					long_name = "Dome Mode"
					description = "When enabled, traces only the upper hemisphere. Directions are always world-aligned (world +Z up)."
					default = "1"
				}
				multiWall = 
				{
					type = "bool"
					long_name = "Count Walls"
					description = "When off, a direction is simply open or blocked, and each ray stops at the first thing it hits. When on, a ray counts every wall between here and the Trace Radius."
					default = "0"
				}
				wallTransmission = 
				{
					type = "float"
					long_name = "Per-Wall Transmission"
					description = "How much of a direction's openness survives each wall it passes through.  Only used when multiWall is on."
					default = "0.5"
					metadata = 
					{
						min = "0.01"
						max = "0.99"
					}
				}
				clusterK = 
				{
					type = "integer"
					long_name = "Cluster K-NN"
					description = "Number of nearest neighbors for clustering."
					default = "6"
				}
				clusterP = 
				{
					type = "float"
					long_name = "Cluster Exponent"
					description = "Exponent applied to cluster size"
					default = "1.5"
					metadata = 
					{
						min = "1.0"
						max = "4.0"
					}
				}
				clusterBlend = 
				{
					type = "float"
					long_name = "Cluster Blend"
					description = "Blend between simple openness (0) and clustered openness (1)."
					default = "1.0"
				}
				opennessExponent = 
				{
					type = "float"
					long_name = "Openness Exponent"
					description = "Stretches the falloff so the value stays audible further from an opening. Lower means a longer tail: 0.33 reaches 0.1 about 10x further out than 1.0. Amplifies ray flicker equally, so raise smoothHalfLife with it."
					default = "0.33"
					metadata = 
					{
						min = "0.05"
						max = "8.0"
					}
				}
				smoothHalfLife = 
				{
					type = "float"
					long_name = "Smoothing Half-Life (seconds)"
					description = "Half-life of an exponential low-pass applied to the openness value, measured in real seconds so it is unaffected by the think rate. 0.0 is instant (no smoothing)."
					default = "0.39"
				}
			}
			inputs = 
			[
				{
					name = "SetSize"
					type = "float"
					description = "Set the trace radius. Invalidates cached results and restarts the sweep."
				},
				{
					name = "SetTotalDirections"
					type = "integer"
					description = "Set total ray directions and recompute the direction set"
				},
				{
					name = "SetTracesPerFrame"
					type = "integer"
					description = "Set rays evaluated per think frame"
				},
			]
		},
