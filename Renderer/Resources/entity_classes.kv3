						{
							value = "3"
							caption = "Bounce"
						},
						{
							value = "4"
							caption = "Lerp"
						},
					]
				}
				AllowGravityGunPull = 
				{
					type = "boolean"
					long_name = "Allow Gravity Gun Pull"
					description = "Responds to Gravity gun pull"
					default = "0"
				}
				RetainVelocity = 
				{
					type = "boolean"
					long_name = "Retain Velocity"
					description = "Retain some velocity from the player's hand"
					default = "0"
				}
				ReactToDynamicPhysics = 
				{
					type = "boolean"
					long_name = "React To Dynamic Physics"
					description = "Move when hit by physics forces"
					default = "0"
				}
				IgnoreHandRotation = 
				{
					type = "boolean"
					long_name = "Ignore Hand Rotation"
					description = "Ignore the rotation (twisting) of the player's hand when interacting"
					default = "1"
				}
				IgnoreHandPosition = 
				{
					type = "boolean"
					long_name = "Ignore Hand Position"
					description = "Ignore the position (offset) of the player's hand when interacting"
					default = "0"
				}
				DoHapticsOnBothHands = 
				{
					type = "boolean"
					long_name = "Do Haptics on both hands"
					description = "Fires haptic pulses on both hands when interacting."
					default = "0"
				}
				PositiveResistance = 
				{
					type = "float"
					long_name = "Resistance"
					description = "Amount of Resistance on Anim Interactable movement (ie 1.0 full, 0.1 slow)"
					default = "1"
				}
				UpdateChildModels = 
				{
					type = "boolean"
					long_name = "Update Children"
					description = "Sets the animation cycle of the children of the Anim Interactable entity"
					default = "0"
				}
				NormalizeChildModelUpdates = 
				{
					type = "boolean"
					long_name = "Normalize Updates to Children"
					description = "Remaps updates to the child models to be between 0 and 1 over the entire range of the interactable."
					default = "0"
				}
				ChildModelAnimgraphParameter = 
				{
