		{
			name = "func_occluder"
			kind = "solid"
			description = "A func_occluder occludes objects behind it. It is used for rendering performance optimization. One use case is to put it into a doorway and toggle it based on whether the door is open or not. Note that geometry surrounding the doorway should have occluders as well, otherwise the benefit of the func_occluder is limited.<br>func_occluders should be as large as possible for best occlusion."
			color = [ 220, 30, 220 ]
			bases = 
			[
				"Targetname:250820",
				"Parentname:250820",
				"EnableDisable",
			]
		},
