			keys = 
			{
				spawnflags = 
				{
					type = "flags"
					default = "2"
					choices = 
					[
						{
							value = "1"
							caption = "Don't remove template entities"
						},
						{
							value = "2"
							caption = "Preserve entity names (Don't do name fixup)"
							default = true
						},
					]
				}
				asynchronous = 
				{
					type = "boolean"
					long_name = "Asynchronous Spawn"
					description = "Allows you to asynchronously spawn the entities referred to by the point template, which will happen at some point later after all dependent resources are downlaoded from UGC servers + asynch streamed in. Asynch point templates have the benefit that they don't precache resources that we never spawn."
					default = "0"
				}
				timeoutInterval = 
				{
					type = "float"
					long_name = "Timeout Interval"
					description = "The amount of seconds after which, if any client hasn't finished streaming the necessary assets, that client is disconnected and the template spawns anyways. Only used in asynchronous point_templates. 0 means use some reasonable default set in the code."
					default = "0"
				}
				entityFilterName = 
				{
					type = "string"
					long_name = "Entity Filter Name"
					description = "Name of an entity filter that can be run on the entities in the template to modify, add, or remove the entities. These filters can be defined in code or in script."
					default = ""
				}
				spawnGroupType = 
				{
					type = "choices"
					long_name = "Spawn Group Type"
					default = "INSERT_INTO_POINT_TEMPLATE_SPAWN_GROUP"
					choices = 
					[
						{
							value = "INSERT_INTO_POINT_TEMPLATE_SPAWN_GROUP"
							caption = "Spawn into point_template's spawn group"
						},
						{
							value = "INSERT_INTO_CURRENTLY_ACTIVE_SPAWN_GROUP"
							caption = "Spawn into the currently active spawn group"
						},
						{
							value = "INSERT_INTO_NEWLY_CREATED_SPAWN_GROUP"
							caption = "Spawn into a newly created spawn group"
						},
					]
				}
				clientOnlyEntityBehavior = 
				{
					type = "choices"
					long_name = "Client Only Entity Behavior"
					description = "This controls the behavior of client only entities spawned by the point_template. Either you can create them only for clients that are currently connected at the point the point_template is spawned (good for transient things like explosions), or you can create them for clients who connect after the point_template is spawned. This behavior only affects point_templates that create their own spawn groups."
					default = "CREATE_FOR_CURRENTLY_CONNECTED_CLIENTS_ONLY"
					choices = 
					[
						{
							value = "CREATE_FOR_CURRENTLY_CONNECTED_CLIENTS_ONLY"
							caption = "Only create for clients connected at the time at which point_template spawns its contents"
						},
						{
							value = "CREATE_FOR_CLIENTS_WHO_CONNECT_LATER"
							caption = "Create for clients who connect after the point_template spawns its contents"
						},
					]
				}
