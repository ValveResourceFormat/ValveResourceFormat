					name = "SetVelocity"
					type = "float"
					description = "Set linear velocity along the constraint"
				},
				{
					name = "SetSlideFriction"
					type = "float"
					description = "Set motor friction, 0 = no friction, 1 = friction that is about enough to counter gravity"
				},
