				}
				TargetCompletionValueE = 
				{
					type = "float"
					long_name = "Target Completion Value E"
					description = "Fire event E when this amount is reached, -1 means disabled"
					default = "-1"
				}
				TargetCompletionValueF = 
				{
					type = "float"
					long_name = "Target Completion Value F"
					description = "Fire event F when this amount is reached, -1 means disabled"
					default = "-1"
				}
				TargetCompletionThreshold = 
				{
					type = "float"
					long_name = "Target Completion Threshold"
					description = "Don't fire a completion event again until the user moves at least this much beyond the completion value (and back)."
					default = "0.1"
				}
				ObjectRequirement = 
				{
					type = "string"
					long_name = "Object requirement"
					description = "Require this object as a hand attachment to interact."
					default = ""
				}
				OnlyRunForward = 
				{
					type = "boolean"
					long_name = "Only run forward"
					description = "Only allow the animation to proceed forward"
					default = "0"
				}
				OnlyRunBackward = 
				{
					type = "boolean"
					long_name = "Only run backward"
					description = "Only allow the animation to proceed backward"
					default = "0"
				}
				LimitForward = 
				{
					type = "float"
					long_name = "Limit Forward"
					description = "Restrict the animation range forward this many cycles"
					default = "1"
				}
				LimitBackward = 
				{
					type = "float"
					long_name = "Limit Backward"
					description = "Restrict the animation range backward this many cycles"
					default = "0"
				}
				LimitStop = 
				{
					type = "float"
					long_name = "Limit Stop"
					description = "Restrict the forward animation progress but not the overall range"
					default = "-1"
				}
				StartLocked = 
				{
					type = "boolean"
					long_name = "Start Locked"
					description = "Spawn in the locked state"
					default = "0"
				}
				LimitLocked = 
				{
					type = "float"
					long_name = "Limit Locked"
					description = "Restrict the animation range this many cycles when locked"
					default = "0"
				}
				ReturnToCompletion = 
				{
					type = "boolean"
					long_name = "Return to Completion"
					description = "When the player releases the handle, return autonomously."
					default = "0"
				}
				ReturnToCompletionAmount = 
				{
					type = "float"
					long_name = "Return to Completion Amount"
					description = "When the player releases the handle, return to this amount of completion autonomously."
					default = "0"
				}
				ReturnToCompletionThreshold = 
				{
					type = "float"
					long_name = "Return to Completion Threshold"
					description = "Determines the threshold [0,1] for the Return to Completion value to be set to 0 or 1 automatically when the player releases the handle."
					default = "-1"
				}
				ReturnToCompletionDelay = 
				{
					type = "float"
					long_name = "Return to Completion Delay"
					description = "When using single controller mode, delay starting Return To Completion for a short period of time when the player releases the handle. ForcePlayerRelease overrides this setting and ReturnToCompletion will start normally."
					default = "0"
				}
				AnimationDuration = 
				{
					type = "float"
					long_name = "Total Animation Duration"
					description = "Used when returning to the return-to-completion amount. If the animation had to return over its entire length, it'd take this long."
					default = "5"
				}
				StartSound = 
				{
					type = "sound"
					long_name = "Start Sound"
					description = "Sound to make when motion begins."
				}
				MoveSound = 
				{
					type = "sound"
					long_name = "Movement Sound"
					description = "Sound to make while moving."
				}
				StopSound = 
				{
					type = "sound"
					long_name = "Stop Sound"
					description = "Player stops interacting with the prop"
				}
				OpenCompleteSound = 
				{
					type = "sound"
					long_name = "Open Complete Sound"
					description = "Sound for the open animation completing"
				}
				CloseCompleteSound = 
				{
					type = "sound"
					long_name = "Close Complete Sound"
					description = "Sound for the close animation completing"
				}
				BounceSound = 
				{
					type = "sound"
					long_name = "Bounce Sound"
					description = "Sound to make when motion end transition begins"
				}
				LockedSound = 
				{
					type = "sound"
					long_name = "Locked Sound"
					description = "Sound to make when the player interacts with the handle while it is locked."
				}
				ReturnForwardMoveSound = 
				{
					type = "sound"
					long_name = "Return to Completion Forward Move Sound"
					description = "Sound for movement during return to completion forward"
				}
				ReturnBackwardMoveSound = 
				{
					type = "sound"
					long_name = "Return to Completion Backward Move Sound"
					description = "Sound for movement during return to completion backward"
				}
				InteractionBoneName = 
				{
					type = "string"
					long_name = "Interaction Bone Name"
					description = "Name of the model interaction bone to match (substring search)"
					default = "interact"
				}
				ReturnToCompletionStyle = 
				{
					type = "choices"
					long_name = "Motion style when returning to completion amount"
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "Ease-in, ease-out"
						},
