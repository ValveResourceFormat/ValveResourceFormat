			}
			inputs = 
			[
				{
					name = "InValue"
					type = "float"
					description = "Input value and fire the output with the remapped value."
				},
			]
			outputs = 
			[
				{
					name = "OutColor"
					type = "color255"
					description = "Fired when the InValue input is received, with the remapped RGB color as the parameter."
				},
