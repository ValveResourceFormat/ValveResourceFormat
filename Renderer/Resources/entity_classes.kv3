					long_name = "Lesson Name"
					description = "Name of the lesson to fire.  Matches name in instructor_lessons.txt."
				}
				hint_target = 
				{
					type = "target_destination"
					long_name = "Target Entity"
					description = "Entity to attach this hint to if required by lesson"
				}
			}
			inputs = 
			[
				{
					name = "ShowHint"
					type = "string"
					description = "Start showing the hint. If an entity name is passed as a parameter, the hint is shown only to that entity."
				},
				{
					name = "EndHint"
					type = "void"
					description = "Stop showing the hint if it hasn't already timed out."
				},
				{
					name = "SetTargetPlayerToActivator"
					type = "void"
					description = "Set the player that should receive this hint to the activator of this input. Only necessary to use this if the player isn't the activator of the ShowHint input. You shouldn't use !player for this, because that only works in singleplayer, and the point of this is to handle multiple players. Instead, fire this input from an output of the entity that the target player activated to initiate the series of events that caused you to want to show them this hint."
				},
			]
			id = "point_instructor_event:250820"
		},
