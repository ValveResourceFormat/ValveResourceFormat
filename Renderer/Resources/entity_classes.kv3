					default = "0"
					metadata = 
					{
						group = "Resolution"
						min = "0"
						max = "256"
					}
				}
				volume_first_slice_thickness = 
				{
					type = "float"
					long_name = "Resolution at Camera"
					description = "Thickness of the first slice in the volume at the camera.  The remaining slices will be warped to maintain this resolution as the draw distance is increased"
					default = "0"
					metadata = 
					{
						group = "Resolution"
						min = "0"
						max = "8"
					}
				}
				FadeInStart = 
				{
					type = "float"
					long_name = "Fade-in start"
					description = "Distance from the eye at which fog starts to fade in."
