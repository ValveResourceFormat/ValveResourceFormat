					type = "integer"
					long_name = "Spawn Priority (int)"
					description = "Determines which spawn points get used first.  Smaller numbers are used before larger numbers."
					default = "0"
				}
				enabled = 
				{
					type = "boolean"
					long_name = "Enabled by default?"
					default = "1"
