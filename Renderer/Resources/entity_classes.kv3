		{
			name = "logic_navigation"
			kind = "point"
			description = "An entity that is used to set navigation properties on other entities. Useful to make NPCs ignore physics props in their way that they can easily push."
			color = [ 220, 30, 220 ]
			mins = [ -8.0, -8.0, -8.0 ]
			maxs = [ 8.0, 8.0, 8.0 ]
			bases = 
			[
				"Targetname:570",
			]
			keys = 
			{
				target = 
				{
					type = "target_destination"
					long_name = "Navigation Entity"
					default = "Name of the entity to set navigation properties on."
				}
				spawnflags = 
				{
					type = "flags"
					default = "1"
					choices = 
					[
						{
							value = "1"
							caption = "Start On"
							default = true
						},
					]
				}
				navprop = 
				{
					type = "choices"
					long_name = "Nav Property"
					default = "Ignore"
					choices = 
					[
						{
							value = "Ignore"
							caption = "NPCs Ignore this when navigating (they'll bump into it)"
						},
					]
				}
			}
			inputs = 
			[
				{
					name = "TurnOn"
					type = "void"
					description = "Turn on. The Navigation Entity will have its navigation properties set."
				},
				{
					name = "TurnOff"
					type = "void"
					description = "Turn off. The Navigation Entity will have its navigation properties returned to the default settings."
				},
				{
					name = "Toggle"
					type = "void"
					description = "Toggle on/off."
				},
			]
			id = "logic_navigation:570"
		},
