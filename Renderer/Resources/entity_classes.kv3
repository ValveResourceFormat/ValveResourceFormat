		{
			name = "phys_spring"
			kind = "point"
			description = "A physically simulated spring. 'Length' is what's known as the 'natural spring length'. This is how long the spring would be if it was at rest (nothing hanging on it or attached). When you attach something to the spring, it will stretch longer than its 'natural length'. The amount of stretch is determined by the 'Sprint Frequency'. The larger the spring frequency the less stretch the spring."
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "editormodel"
					arguments = 
					[
						"models/editor/axis_helper",
					]
				},
				{
					name = "vecline"
					arguments = 
					[
						"springaxis",
					]
				},
			]
			bases = 
			[
				"Targetname:250820",
				"BasePhysicsNoSettleAttached",
			]
			keys = 
			{
				spawnflags = 
				{
					type = "flags"
					default = ""
					choices = 
					[
						{
							value = "1"
							caption = "Force only on stretch"
						},
					]
				}
				attach1 = 
				{
					type = "target_destination"
					long_name = "Entity 1"
					default = ""
				}
				attach2 = 
				{
					type = "target_destination"
					long_name = "Entity 2"
					default = ""
				}
				springaxis = 
				{
					type = "vecline"
					long_name = "Spring Axis"
					description = "Use the helper. Drag it out to match the virtual spring."
					default = ""
				}
				length = 
				{
					type = "string"
					long_name = "Length"
					description = "How long the spring would be if it was at rest (nothing hanging on it or attached). 0 means the length of the helpr ."
					default = "0"
				}
				frequency = 
				{
					type = "string"
					long_name = "Frequency"
					description = "The stiffness of the spring.  The larger the number the less the spring will stretch. The maximum should be not more than 30!"
					default = "5"
				}
				damping = 
				{
					type = "string"
					long_name = "Damping Ratio"
					description = "How much energy the spring loses. Values less than one give you an osscilating spring. A value of one makes the spring return without overshooting"
					default = "0.7"
				}
			}
			inputs = 
			[
				{
					name = "SetRestLength"
					type = "float"
					description = "Set the spring rest length."
				},
				{
					name = "SetFrequency"
					type = "float"
					description = "Set the spring frequency (stiffness)."
				},
				{
					name = "SetDampingRatio"
					type = "float"
					description = "Set the spring damping ratio."
				},
			]
			id = "phys_spring:250820"
		},
