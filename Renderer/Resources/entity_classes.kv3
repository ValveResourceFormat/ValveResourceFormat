				{
					name = "HideSprite"
					type = "void"
					description = "Hide the sprite. Won't be drawn until the 'ShowSprite' input is received."
				},
				{
					name = "ShowSprite"
					type = "void"
					description = "Show the sprite."
				},
				{
					name = "ToggleSprite"
					type = "void"
					description = "Toggle the sprite between hidden and shown."
				},
