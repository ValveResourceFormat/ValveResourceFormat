					default = "200"
				}
				noise = 
				{
					type = "float"
					long_name = "Noise"
					description = "The amount of directional noise (0-1). 0 = no noise, 1 = random direction."
					default = "0.1"
				}
				viewkick = 
				{
					type = "float"
					long_name = "Viewkick"
