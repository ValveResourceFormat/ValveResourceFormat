				{
					name = "ForceSpawnAtEntityOrigin"
					type = "targetdestination"
					description = "Spawn an instance of the template that the same origin and angle as the specified entity (specify by targetname in parameters)"
				},
			]
			outputs = 
			[
				{
					name = "OnEntitySpawned"
					type = "void"
					description = "Fired when an instance of the entity template has been spawned."
				},
				{
					name = "OnEntityFailedSpawn"
					type = "void"
					description = "Fired when a ForceSpawn input failed to spawn the template, either due to lack of space or being in player's view, depending on the spawnflags."
				},
			]
			id = "env_entity_maker:250820"
		},
		{
			name = "env_entity_maker"
			kind = "point"
			description = "Spawns the specified entity template at its origin. If set to auto-spawn, it will spawn the template whenever there's room and the player is looking elsewhere."
			color = [ 220, 30, 220 ]
			bases = 
			[
				"Targetname:570",
				"Parentname:570",
			]
			keys = 
			{
				spawnflags = 
				{
					type = "Flags"
					default = ""
					choices = 
					[
						{
							value = "1"
							caption = "Enable AutoSpawn (will spawn whenever there's room)"
						},
						{
							value = "2"
							caption = "AutoSpawn: Wait for entity destruction"
						},
						{
							value = "4"
							caption = "AutoSpawn: Even if the player is looking"
						},
						{
							value = "8"
							caption = "ForceSpawn: Only if there's room"
						},
						{
							value = "16"
							caption = "ForceSpawn: Only if the player isn't looking"
						},
					]
				}
				EntityTemplate = 
				{
					type = "target_destination"
					long_name = "Point_template To Spawn"
					description = "Name of the point_template to spawn here. If there is an offset between the point_template and its spawned entities in hammer, that offset will be maintained when spawning happens relative to the env_entity_maker."
					default = ""
				}
				PostSpawnSpeed = 
				{
					type = "float"
					long_name = "PostSpawn Movement Speed"
					description = "If specified, all the entities created in the template will move this fast in the specified PostSpawn Movement Direction."
					default = "0"
				}
				PostSpawnDirection = 
				{
					type = "angle"
					long_name = "PostSpawn Movement Direction"
					description = "If a PostSpawn Movement Speed is specified, this angle will be added to the movement direction all the entities created by the template."
					default = "0 0 0"
				}
				PostSpawnDirectionVariance = 
				{
					type = "float"
					long_name = "PostSpawn Direction Variance"
					description = "This variance is applied to the PostSpawn Movement Direction for each spawned entity in the template. Use it to apply some randomness to the directions."
					default = "0.15"
				}
				PostSpawnInheritAngles = 
				{
					type = "boolean"
					long_name = "PostSpawn Inherit Angles"
					description = "If checked, uses the parent's forward vector as the spawn direction. Otherwise uses the entity maker's forward."
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "ForceSpawn"
					type = "void"
					description = "Spawn an instance of the template at this origin and angle."
				},
				{
					name = "ForceSpawnAtEntityOrigin"
					type = "targetdestination"
					description = "Spawn an instance of the template that the same origin and angle as the specified entity (specify by targetname in parameters)"
				},
			]
			outputs = 
			[
				{
					name = "OnEntitySpawned"
					type = "void"
					description = "Fired when an instance of the entity template has been spawned."
				},
				{
					name = "OnEntityFailedSpawn"
					type = "void"
					description = "Fired when a ForceSpawn input failed to spawn the template, either due to lack of space or being in player's view, depending on the spawnflags."
				},
			]
