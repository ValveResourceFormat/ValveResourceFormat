			name = "phys_convert"
			kind = "point"
			description = "Turns an arbitrary entity into a physically simulated entity. i.e. brush entities will behave like func_physbox, model entities behave like prop_physics."
			color = [ 0, 0, 255 ]
			mins = [ -8.0, -8.0, -8.0 ]
			maxs = [ 8.0, 8.0, 8.0 ]
			bases = 
