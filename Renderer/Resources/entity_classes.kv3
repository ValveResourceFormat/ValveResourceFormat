		{
			name = "prop_physics"
			kind = "point"
			description = "A prop that physically simulates as a single rigid body. It can be constrained to other physics objects using hinges or other constraints. It can also be configured to break when it takes enough damage. Note that the health of the object will be overridden by the health inside the model, to ensure consistent health game-wide. If the model used by the prop is configured to be used as a prop_dynamic (i.e. it should not be physically simulated) then it CANNOT be used as a prop_physics. Upon level load it will display a warning in the console and remove itself. Use a prop_dynamic instead."
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "model"
				},
				{
					name = "sphere"
					arguments = 
					[
						"fademindist",
					]
				},
				{
					name = "sphere"
					arguments = 
					[
						"fademaxdist",
					]
				},
				{
					name = "model_archetypes"
					arguments = 
					[
						"physics_prop_model",
						"breakable_prop_model",
					]
				},
			]
			bases = 
			[
				"BasePropPhysics:250820",
				"RenderFields:250820",
				"BasePhysicsSimulated",
			]
			keys = 
			{
				ExploitableByPlayer = 
				{
					type = "choices"
					long_name = "Exploitable by Player"
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "Default"
						},
						{
							value = "1"
							caption = "Explosive"
						},
					]
					metadata = 
					{
						group = "Misc"
					}
				}
				CollisionGroupOverride = 
				{
					type = "choices"
					long_name = "Collision Group Override"
					default = "-1"
					choices = 
					[
						{
							value = "-1"
							caption = "UNUSED"
						},
						{
							value = "0"
							caption = "COLLISION_GROUP_ALWAYS"
						},
						{
							value = "1"
							caption = "COLLISION_GROUP_NONPHYSICAL"
						},
						{
							value = "4"
							caption = "COLLISION_GROUP_DEFAULT"
						},
						{
							value = "5"
							caption = "COLLISION_GROUP_DEBRIS"
						},
						{
							value = "14"
							caption = "COLLISION_GROUP_WEAPON"
						},
					]
					metadata = 
					{
						group = "Misc"
					}
				}
				SilentToZombies = 
				{
					type = "boolean"
					long_name = "Silent To Zombies"
					description = "Should this prop generate sounds that blind zombies can hear."
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "Ignite"
					type = "void"
					description = "Ignite, burst into flames."
				},
				{
					name = "IgniteLifetime"
					type = "float"
					description = "Ignite, with a parameter lifetime."
				},
				{
					name = "IgniteNumHitboxFires"
					type = "integer"
					description = "Ignite, with a parameternumber of hitbox fires."
				},
				{
					name = "IgniteHitboxFireScale"
					type = "float"
					description = "Ignite, with a parameter hitbox fire scale."
				},
			]
			id = "prop_physics:250820"
		},
