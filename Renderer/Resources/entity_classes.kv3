		{
			name = "trigger_look"
			kind = "solid"
			description = "An entity used to trigger something when the player looks at something. It fires 'OnTrigger' when the player looks at a target entity for the given amount of time, while within the trigger volume. If the player leaves the trigger or looks away from the target entity the clock resets. If the 'Use Velocity instead of facing' spawnflag is checked, the trigger uses the player's velocity instead of the player's view, so it determines whenever the player is moving toward the target entity. Useful for triggering when players are driving a vehicle at something.NOTE: Only designed for single-player game. "
			color = [ 220, 30, 220 ]
			auto_apply_material = "materials/tools/toolstrigger.vmat"
			bases = 
			[
				"Trigger:250820",
			]
			keys = 
			{
				spawnflags = 
				{
					type = "flags"
					default = "128"
					choices = 
					[
						{
							value = "128"
							caption = "Fire Once"
							default = true
						},
						{
							value = "256"
							caption = "Use Velocity instead of facing"
						},
						{
							value = "1"
							caption = "Clients"
							default = true
						},
						{
							value = "2"
							caption = "NPCs"
						},
						{
							value = "4"
							caption = "Pushables"
						},
						{
							value = "8"
							caption = "Physics Objects"
						},
						{
							value = "16"
							caption = "Only player ally NPCs"
						},
						{
							value = "32"
							caption = "Only clients in vehicles"
						},
						{
							value = "64"
							caption = "Everything (not including physics debris)"
						},
						{
							value = "512"
							caption = "Only clients *not* in vehicles"
						},
						{
							value = "1024"
							caption = "Physics debris"
						},
						{
							value = "2048"
							caption = "Only NPCs in vehicles (respects player ally flag)"
						},
						{
							value = "4096"
							caption = "Correctly account for object mass (trigger_push used to assume 100Kg) and multiple component physobjs (car, blob...)"
							default = true
						},
						{
							value = "8192"
							caption = "Ignore client's hands"
						},
					]
				}
				target = 
				{
					type = "target_destination"
					long_name = "Look Target"
					description = "The name of the entity to be looked at."
				}
				LookTime = 
				{
					type = "string"
					long_name = "Look Time"
					description = "The time, in seconds, that the player must look the target before firing the output. Resets if player leaves trigger, or looks outside the Field of View threshold."
					default = "0.5"
				}
				FieldOfView = 
				{
					type = "string"
					long_name = "Field Of View"
					description = "How close the player has to be looking at the target.<br><br> 1.0 = straight ahead<br> 0.0 = +/- 90 degrees<br> -1.0 = all directions"
					default = "0.9"
				}
				FOV2D = 
				{
					type = "boolean"
					long_name = "Use 2D Field Of View"
					description = "In 2D mode the look angle FOV is only checked along the x and y axes, not the z."
					default = "0"
				}
				Timeout = 
				{
					type = "float"
					long_name = "Timeout"
					description = "The time, in seconds, to wait after player enters the trigger before firing the OnTimeout output, 0 = never. NOTE: When the timeout expires, the OnTrigger output does NOT fire!"
					default = "0"
				}
				test_occlusion = 
				{
					type = "boolean"
					long_name = "Test occlusion"
					description = "If set, player must have clear LOS to the target (ignoring dynamic entities)."
					default = "0"
				}
			}
			outputs = 
			[
				{
					name = "OnTrigger"
					type = "void"
					description = "Fired when the trigger is activated. Does NOT fire if the timeout expires."
				},
				{
					name = "OnTimeout"
					type = "void"
					description = "Fired after the timeout interval expires if the player never looked at the target. OnTrigger does NOT fire in this case."
				},
				{
					name = "OnStartLook"
					type = "void"
					description = "Fired once when the player looks until they have unlooked/untouched."
				},
				{
					name = "OnEndLook"
					type = "void"
					description = "Fired when the player was looking and unlooked while still touching."
				},
			]
			id = "trigger_look:250820"
		},
