					description = "Minimum rotation limit around hinge axis"
					default = "0"
					metadata = 
					{
						min = "-180.0"
						max = "0.0"
					}
				}
				max_rotation = 
				{
					type = "float"
					long_name = "Max Rotation Limit"
					description = "Maximum rotation limit around hinge axis"
					default = "0"
					metadata = 
					{
						min = "0.0"
						max = "180.0"
					}
				}
				initial_rotation = 
				{
					type = "float"
					long_name = "Initial rotation"
					description = "Initial rotation of the hinge (values -1 to 1 where -1 mean open at minimum limit and 1 means open at maximum limit)"
					default = "0"
				}
				hingeaxis = 
				{
					type = "localaxis"
					long_name = "Local Space Hinge Axis"
					default = "-8 0 0, 8 0 0"
				}
				motorfrequency = 
				{
					type = "float"
					long_name = "Motor frequency"
					description = "Range 0 - 30 (only used when driving the relative angle through the angle input)"
					default = "10"
				}
				motordampingratio = 
				{
					type = "float"
					long_name = "Motor damping ratio"
					description = "Range 0 - 1 (only used when driving the relative angle through the angle input)"
					default = "1"
				}
				SystemLoadScale = 
				{
					type = "float"
					long_name = "Load Scale"
					description = "Scale of the load connected to this hinge (1=just the objects directly connected)"
					default = "1"
				}
				AngleSpeedThreshold = 
				{
					type = "float"
					long_name = "Threshold for move events"
				}
			}
			inputs = 
			[
				{
					name = "SetAngularVelocity"
					type = "float"
					description = "Set angular velocity around the hinge (motor) in deg/sec"
				},
				{
					name = "SetHingeFriction"
					type = "float"
					description = "Set Motor Friction, 0 = no friction, 1 = friction that is about enough to counter gravity"
				},
				{
					name = "SetMinLimit"
					type = "float"
					description = "Set the minimum hinge angle (degrees)"
				},
				{
					name = "SetMaxLimit"
					type = "float"
					description = "Set the maximum hinge angle (degrees)"
				},
				{
					name = "TurnMotorOff"
					type = "void"
					description = "Turn Motor Off, will turn all friction off"
				},
				{
					name = "SetMotorTargetVelocity"
					type = "float"
					description = "Set Motor target velocity in deg/sec, use 0 to just turn friction on"
				},
				{
					name = "SetMotorTargetAngle"
					type = "float"
					description = "Set Motor target angle, degrees. Exact number depends on constrained bodies reference frames and initial configuration. See constraint limits for reference to sensible range of values."
				},
			]
			outputs = 
			[
				{
					name = "NotifyMinLimitReached"
					type = "void"
					description = "The min limit has been reached."
				},
				{
					name = "NotifyMaxLimitReached"
					type = "void"
					description = "The max limit has been reached."
				},
				{
					name = "OnStartMoving"
					type = "void"
					description = "Fires if the attached objects start rotating around the hinge axis relatively to each other."
				},
				{
					name = "OnStopMoving"
					type = "void"
					description = "Fires if the attached objects stip rotating around the hinge axis relatively to each other."
				},
			]
			id = "phys_hinge_local:570"
		},
