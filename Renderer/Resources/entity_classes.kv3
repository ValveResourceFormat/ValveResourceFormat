			keys = 
			{
				m_iszEntity = 
				{
					type = "target_destination"
					long_name = "Target NPC"
					description = "The name or class name (such as 'npc_zombie') of an NPC to use for this script."
				}
				m_iszIdle = 
				{
					type = "sequence"
					long_name = "Pre Action Idle Animation"
					description = "The name of the sequence (such as 'idle01') or activity (such as 'ACT_IDLE') to play before the action animation if the NPC must wait for the script to be triggered. Use 'Start on Spawn' flag or MoveToPosition input to play this idle animation."
					default = ""
				}
				m_iszEntry = 
				{
					type = "sequence"
					long_name = "Entry Animation"
					description = "The name of the sequence (such as 'reload02') or activity (such as 'ACT_RELOAD') to play when the sequence starts, before transitioning to play the main action sequence."
					default = ""
				}
				m_iszPlay = 
				{
					type = "sequence"
					long_name = "Action Animation"
					description = "The name of the main sequence (such as 'reload02') or activity (such as 'ACT_RELOAD') to play."
					default = ""
				}
				m_iszPostIdle = 
				{
					type = "sequence"
					long_name = "Post Action Idle Animation"
					description = "The name of the sequence (such as 'idle01') or activity (such as 'ACT_IDLE') to play after the action animation."
					default = ""
				}
				m_iszCustomMove = 
				{
					type = "sequence"
					long_name = "Custom Move Animation"
					description = "Used in conjunction with the 'Custom movement' setting for the 'Move to Position' property, specifies the sequence (such as 'crouch_run01') or activity (such as 'ACT_RUN') to use while moving to the scripted position."
					default = ""
				}
				sync_group = 
				{
					type = "string"
					long_name = "Synchronization Group"
					description = "If set, identifier used to match other scripted sequences to synchronze with (alternative to name-based sync)"
				}
				m_bLoopActionSequence = 
				{
					type = "boolean"
					long_name = "Loop Action Animation?"
					default = "0"
				}
				m_bSynchPostIdles = 
				{
					type = "boolean"
					long_name = "Synch Post Idles?"
					default = "0"
				}
				m_bAllowCustomInterruptConditions = 
				{
					type = "boolean"
					long_name = "Allow custom interrupt conditions to be set."
					default = "0"
				}
				conflict_response = 
				{
					type = "choices"
					long_name = "Script Conflict Response"
					description = "What to do if this scripted sequence begins and the actor is already executing a scripted sequence."
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "Enqueue"
						},
						{
							value = "1"
