		{
			name = "prop_handpose"
			kind = "point"
			description = "A pose region for the VR hand"
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "model"
					arguments = 
					[
						"editormodel",
					]
				},
				{
					name = "vecline_local"
					arguments = 
					[
						"Extent",
						"255",
						"255",
						"128",
					]
				},
			]
			bases = 
			[
				"BasePropPhysics:546560",
				"Targetname:250820",
				"Parentname:250820",
				"EnableDisable",
			]
			keys = 
			{
				model = 
				{
					type = "studio"
					sub_type = "vmdl"
					long_name = "Model"
					default = "models/props/max/handposes/handpose_flatpalm.vmdl"
				}
				DistanceMin = 
				{
					type = "float"
					long_name = "Distance Min"
					description = "Full pose within this radius"
					default = "4"
				}
				DistanceMax = 
				{
					type = "float"
					long_name = "Distance Max"
					description = "Zero pose outside this radius"
					default = "6"
				}
				DistanceBias = 
				{
					type = "float"
					long_name = "Distance Bias"
					description = "Pose weight distance bias"
					default = "0.3"
				}
				DisengageDistance = 
				{
					type = "float"
					long_name = "Disengage Distance"
					description = "Distance at which the hand pose will disengage entirely"
					default = "16"
				}
				UseProximityBone = 
				{
					type = "boolean"
					long_name = "Use Proximity Bones"
					description = "Measure interaction range via authored bone positions instead of origins."
					default = "0"
				}
				AddToSpatialPartition = 
				{
					type = "boolean"
					long_name = "Add To Spatial Partition"
					description = "Set to true if the pose is static or has a small move bounds (doors, levers)"
					default = "1"
				}
				DeleteAfterSpawn = 
				{
					type = "boolean"
					long_name = "Convert to Hand Conform Data"
					description = "Convert pose to conform data and delete the entity"
					default = "0"
				}
				AutoGrip = 
				{
					type = "boolean"
					long_name = "Auto Grip"
					description = "Force grip when fully posed, even if the player isn't gripping"
					default = "0"
				}
				Extent = 
				{
					type = "vector"
					long_name = "Extent"
					description = "Defines a range over which the handpose can be located."
					default = ""
				}
				IgnoreHand = 
				{
					type = "choices"
					long_name = "Ignore Hand"
					description = "This hand will not active the hand pose"
					default = "-1"
					choices = 
					[
						{
							value = "-1"
							caption = "None"
						},
						{
							value = "0"
							caption = "Right hand"
						},
						{
							value = "1"
							caption = "Left hand"
						},
					]
				}
			}
			inputs = 
			[
				{
					name = "SetAutoGrip"
					type = "boolean"
					description = "Toggle Auto-Grip"
				},
			]
			outputs = 
			[
				{
					name = "OnHandPosed"
					type = "void"
					description = "Fires when the hand is closer than DistanceMin"
				},
				{
					name = "OnHandUnPosed"
					type = "void"
					description = "Fires when the hand is no longer closer than DistanceMin"
				},
			]
		},
