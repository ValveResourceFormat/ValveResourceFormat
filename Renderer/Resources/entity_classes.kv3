						{
							value = "32"
							caption = "Ignore Pos"
						},
						{
							value = "1"
							caption = "Start On"
						},
						{
							value = "2"
							caption = "Apply Force"
							default = true
						},
						{
							value = "4"
							caption = "Apply Torque"
							default = true
						},
						{
							value = "8"
							caption = "Orient Locally"
							default = true
						},
						{
							value = "16"
							caption = "Ignore Mass"
						},
					]
				}
				force = 
				{
					type = "string"
					long_name = "Force"
					description = "Force (will be integrated, units are force kg*in/s^2)"
					default = "0"
				}
			}
			id = "phys_thruster:250820"
		},
