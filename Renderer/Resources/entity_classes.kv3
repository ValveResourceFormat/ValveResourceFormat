						{
							variable = "mode"
							value = "1"
						}
					}
				}
				smoothHalfLife = 
				{
					type = "float"
					long_name = "Smoothing Half-Life (seconds)"
					description = "Half-life of a low-pass on the output, in real seconds so it is unaffected by the think rate. 0.0 is instant."
