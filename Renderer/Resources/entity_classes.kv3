		{
			name = "env_physexplosion"
			kind = "point"
			description = "An entity that creates an explosion at its origin. If the no-damage spawnflag is set, the explosion won't be visible, but will apply force to any physics objects within its radius."
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "sphere"
				},
				{
					name = "sphere"
					arguments = 
					[
						"inner_radius",
					]
				},
				{
					name = "iconsprite"
					arguments = 
					[
						"editor/env_physexplosion.vmat",
					]
				},
			]
			bases = 
			[
				"Targetname:250820",
				"Parentname:250820",
			]
			keys = 
			{
				magnitude = 
				{
					type = "string"
					long_name = "Magnitude"
					description = "Amount of physics force applied by the explosion."
					default = "100"
				}
				radius = 
				{
					type = "string"
					long_name = "Clamp Radius (0 = auto)"
					description = "If specified, the radius in which the explosion damages entities. If unspecified, the radius will be based on the magnitude."
					default = "0"
				}
				targetentityname = 
				{
					type = "target_destination"
					long_name = "Limit to Entity"
					description = "If specified, the explosion will only affect the matching entity."
					default = ""
				}
				explodeonspawn = 
				{
					type = "boolean"
					long_name = "Explode on spawn"
					default = "Performs the physics explosion immediately upon spawning."
				}
				spawnflags = 
				{
					type = "flags"
					default = "1"
					choices = 
					[
						{
							value = "1"
							caption = "No Damage - Only Force"
							default = true
						},
						{
							value = "2"
							caption = "Push players"
						},
						{
							value = "4"
							caption = "Push radially - not as a sphere"
						},
						{
							value = "8"
							caption = "Test LOS before pushing"
						},
						{
							value = "16"
							caption = "Disorient player if pushed"
						},
					]
				}
				inner_radius = 
				{
					type = "float"
					long_name = "Inner radius"
					description = "If not zero, the LOS is calculated from a point intersecting this sphere."
					default = "0"
				}
				pushscale = 
				{
					type = "float"
					long_name = "Physics push scale"
					description = "Scale the applied physics force by this value."
					default = "1"
				}
			}
			inputs = 
			[
				{
					name = "Explode"
					type = "void"
					description = "Trigger the explosion."
				},
			]
			outputs = 
			[
				{
					name = "OnPushedPlayer"
					type = "void"
					description = "Fires when the player is pushed by the explosion."
				},
			]
			id = "env_physexplosion:250820"
		},
