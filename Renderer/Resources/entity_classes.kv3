				m_nGroundIKPreference = 
				{
					type = "choices"
					long_name = "Ground IK Preference"
					description = "If this NPC has ground IK; whether we disable it for the playthrough of the sequence or not."
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "No change"
						},
						{
							value = "1"
							caption = "Disable for this sequence"
						},
					]
				}
				m_flRadius = 
				{
					type = "integer"
					long_name = "Search Radius (0=everywhere)"
					description = "Radius to search within for an NPC to use. 0 searches everywhere."
					default = "0"
				}
				m_flRepeat = 
				{
					type = "integer"
					long_name = "Repeat Rate ms"
					default = "0"
				}
				m_fMoveTo = 
				{
					type = "Choices"
					long_name = "Move to Position"
					default = "1"
					choices = 
					[
						{
