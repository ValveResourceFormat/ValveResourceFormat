				"RenderFields:250820",
			]
			keys = 
			{
				movedir = 
				{
					type = "angle"
					long_name = "Move Direction (Pitch Yaw Roll)"
					description = "The direction the brushes will move, when told to."
					default = "0 0 0"
				}
				movedir_islocal = 
				{
					type = "boolean"
					long_name = "Move Direction is Expressed in Local Space"
					description = "If checked, the movement direction angle is in local space and should be rotated by the entity's angles after spawning."
					default = "1"
				}
				spawnflags = 
				{
					type = "flags"
					default = ""
					choices = 
					[
						{
							value = "8"
							caption = "Not Solid"
						},
					]
				}
				startposition = 
				{
					type = "float"
					long_name = "Start Position"
					description = "Position of brush when spawned. The range is a value between 0.0 and 1.0, where 0 is the starting position and 1 is the starting position + (move direction * move distance)."
					default = "0"
				}
				speed = 
				{
					type = "integer"
					long_name = "Speed"
					description = "The speed that the brush moves, in inches per second."
					default = "100"
				}
				movedistance = 
				{
					type = "float"
					long_name = "Move Distance"
					description = "The distance from the starting point that the brush should move, in inches."
					default = "100"
				}
				blockdamage = 
				{
					type = "float"
					long_name = "Block Damage"
					description = "The amount of damage to do to any entity that blocks the brushes, per frame."
					default = "0"
