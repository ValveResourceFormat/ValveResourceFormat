				"BreakableProp:250820",
				"SystemLevelChoice",
				"RenderFields:250820",
				"Glow:250820",
			]
			keys = 
			{
				spawnflags = 
				{
					type = "flags"
					default = ""
					choices = 
					[
						{
							value = "64"
							caption = "Use Hitboxes for Renderbox"
						},
						{
							value = "256"
							caption = "Start with collision disabled"
						},
						{
							value = "512"
							caption = "Set to NAVIgnore"
						},
						{
							value = "16"
							caption = "Break on Touch"
						},
						{
							value = "32"
							caption = "Break on Pressure"
						},
					]
				}
				renderamt = 
				{
					type = "integer"
					long_name = "Alpha"
					description = "Alpha of the fade, where 0 = fully transparent and 255 = fully opaque."
					default = "255"
				}
				rendercolor = 
				{
					type = "color255"
					long_name = "Color (R G B)"
					default = "255 255 255"
				}
				solid = 
				{
					type = "choices"
					long_name = "Collisions"
					default = "6"
					choices = 
					[
						{
							value = "0"
							caption = "Not Solid"
						},
						{
							value = "2"
							caption = "Use axis-aligned box"
						},
						{
							value = "3"
							caption = "Use oriented Box"
						},
						{
							value = "6"
							caption = "Use VPhysics"
						},
					]
				}
				disablelowviolence = 
				{
					type = "choices"
					long_name = "Turn Off in Low-Violence"
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "No"
						},
						{
							value = "1"
							caption = "Yes"
						},
					]
				}
				DefaultAnim = 
				{
					type = "sequence"
					long_name = "Default Animation"
					description = "The name of the idle animation that this prop will revert to whenever it finishes a random or forced animation."
					default = ""
				}
				RandomAnimation = 
				{
					type = "boolean"
					long_name = "Randomly Animate"
					description = "If set, this prop will randomly choose and play animations, based upon the times specified in 'Min/Max Random Anim Time'. Inbetween the random animations, it will revert to playing the 'Default Animation'."
					default = "0"
				}
				HoldAnimation = 
				{
					type = "boolean"
					long_name = "Hold Animation"
					description = "If set, the prop will not loop its animation, but hold the last frame."
					default = "0"
				}
				randomizecycle = 
				{
					type = "boolean"
					long_name = "Randomize cycle"
					description = "If set, this prop will randomize its cycle when it begins animating. Use this to desynchronize animating props that use the same model."
					default = "0"
				}
				MinAnimTime = 
				{
					type = "float"
					long_name = "Min Random Anim Time"
					description = "Minimum time between random animations."
					default = "5"
				}
				MaxAnimTime = 
				{
					type = "float"
					long_name = "Max Random Anim Time"
					description = "Maximum time between random animations."
					default = "10"
				}
				LagCompensate = 
				{
					type = "boolean"
					long_name = "Lag Compensation"
					description = "Enable to lag compensate this prop, should be use very sparingly!"
					default = "0"
				}
				AnimateOnServer = 
				{
					type = "boolean"
					long_name = "Animate on server in multiplayer"
					description = "Enable this to animate on the server in multiplayer games, such as for props with triggers parented to attachment points. Use sparingly as there is a performance cost."
					default = "0"
				}
				ScriptedMovement = 
				{
					type = "boolean"
					long_name = "Scripted Movement"
					description = "Set this to allow vscript code to move the prop via SetVelocity() calls."
					default = "0"
				}
				velocity = 
				{
					type = "vector"
					long_name = "Initial Velocity"
					description = "Only used if Scripted Movement is set, sets an initial linear velocity for the entity."
				}
				avelocity = 
				{
					type = "vector"
					long_name = "Initial Rotational Velocity"
					description = "Only used if Scripted Movement is set, sets an initial rotational velocity for the entity."
				}
				lightingorigin = 
				{
					type = "target_destination"
					long_name = "Lighting Origin"
					description = "Select a path_corner entity to specify a location to sample lighting from, instead of using this entity's origin."
					default = ""
				}
				updatechildren = 
				{
					type = "boolean"
					long_name = "Update children"
					description = "Update touches for any children that are attached to attachment points as this prop animates. This allows SetParentAttached triggers or func_brushes to touch properly."
					default = "0"
				}
				use_animgraph = 
				{
					type = "boolean"
					long_name = "Allow Animgraph"
					description = "Allow this entity to use its animgraph"
					default = "0"
				}
				CreateNavObstacle = 
				{
					type = "boolean"
					long_name = "Create Nav Obstacle"
					description = "Create a navigation obstacle to assist NPC pathfinding"
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "SetAnimation"
					type = "string"
					description = "Force the prop to play an animation. The parameter should be the name of the animation."
				},
				{
					name = "SetAnimationNoReset"
					type = "string"
					description = "Force the prop to play an animation unless the prop is already playing the animation. The parameter should be the name of the animation."
				},
				{
					name = "SetAnimationTransition"
					type = "string"
					description = "Force the prop to play an animation. The parameter should be the name of the animation. The second animation is the name of the animation it's transitioning from. If that one is still playing it'll just reverse from the current frame."
				},
				{
					name = "SetDefaultAnimation"
					type = "string"
					description = "Set the Default Animation to the one specified in the parameter."
				},
				{
					name = "SetPlaybackRate"
					type = "float"
					description = "Set the playback rate for the animation."
				},
				{
					name = "SetBodyGroup"
					type = "string"
					description = "Sets bodygroup. Format is <BodygroupName,index> "
				},
				{
					name = "TurnOn"
					type = "void"
					description = "Make the prop visible."
				},
				{
					name = "TurnOff"
					type = "void"
					description = "Make the prop invisible."
				},
				{
					name = "EnableCollision"
					type = "void"
					description = "Enable collision on the prop."
				},
				{
					name = "DisableCollision"
					type = "void"
					description = "Disable collision on the prop."
				},
				{
					name = "SetNavIgnore"
					type = "boolean"
					description = "Enable and disable NAVIgnore on the prop."
				},
				{
					name = "SetAnimGraphParameter"
					type = "string"
					description = "Set an animation graph parameter Format: <name=value>"
				},
			]
			outputs = 
			[
				{
					name = "OnAnimationBegun"
					type = "void"
					description = "Fired whenever a new animation has begun playing."
				},
				{
					name = "OnAnimationDone"
					type = "void"
					description = "Fired whenever an animation is complete."
				},
				{
					name = "OnAnimationReachedEnd"
					type = "void"
					description = "Fired whenever a non-looping animation playing forward hits the end (cycle=1)."
				},
				{
					name = "OnAnimationReachedStart"
					type = "void"
					description = "Fired whenever a non-looping animation playing backward hits the beginning (cycle=0)."
				},
				{
					name = "OnAnimationLoopCycleDone"
					type = "void"
					description = "Fires off an event when the current cycle of a looped animation is complete."
				},
			]
			id = "prop_dynamic_base:250820"
