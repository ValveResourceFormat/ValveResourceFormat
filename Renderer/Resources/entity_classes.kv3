		{
			name = "phys_magnet"
			kind = "point"
			description = "An entity that acts like a magnet, attaching metallic physics objects to itself when they touch it."
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "editormodel"
				},
			]
			bases = 
			[
				"Targetname:250820",
				"Parentname:250820",
				"Studiomodel:250820",
			]
			keys = 
			{
				spawnflags = 
				{
					type = "flags"
					default = ""
					choices = 
					[
						{
							value = "1"
							caption = "Start Asleep"
						},
						{
							value = "2"
							caption = "Motion Disabled"
						},
						{
							value = "4"
							caption = "Suck On Touch"
						},
						{
							value = "8"
							caption = "Allow Attached Rotation"
						},
						{
							value = "16"
							caption = "Coast jeep pickup hack"
						},
					]
				}
				forcelimit = 
				{
					type = "float"
					long_name = "Impulse Limit to Break (kg)"
					description = "The amount of impulse necessary to break a stuck object off the magnet. A way of calculating this is to set it to the mass of an object that would break this constraint if it were resting on the magnet."
					default = "0"
				}
				torquelimit = 
				{
					type = "float"
					long_name = "Angular Impulse Limit to Break (kg * distance)"
					description = "The amount of angular impulse necessary to break a stuck object off the magnet. A way of calculating this is to multiply any reference mass by the resting distance (from the center of mass of the object) needed to break the constraint."
					default = "0"
				}
				massScale = 
				{
					type = "float"
					long_name = "Mass Scale"
					description = "A scale multiplier for the object's mass."
					default = "0"
				}
				maxobjects = 
				{
					type = "integer"
					long_name = "Maximum Attached Objects"
					description = "The maximum number of physics objects that can be stuck to the magnet at once. 0 = no limit."
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "TurnOn"
					type = "void"
					description = "Turn the magnet on."
				},
				{
					name = "TurnOff"
					type = "void"
					description = "The the magnet off. This will detach anything current stuck to the magnet."
				},
			]
			outputs = 
			[
				{
					name = "OnAttach"
					type = "void"
					description = "Fired when an entity is grabbed by the magnet."
				},
				{
					name = "OnDetach"
					type = "void"
					description = "Fired when an entity is released by the magnet."
				},
			]
			id = "phys_magnet:250820"
		},
