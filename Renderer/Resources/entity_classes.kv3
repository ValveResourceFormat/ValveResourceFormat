		{
			name = "RenderFields"
			kind = "base"
			bases = 
			[
				"RenderFxChoices",
				"RenderModeChoices:730",
				"SystemLevelChoice",
			]
			keys = 
			{
				renderamt = 
				{
					type = "integer"
					long_name = "FX Amount (0 - 255)"
					description = "The FX amount is used by the selected Render Mode."
					default = "255"
					metadata = 
					{
						group = "Render Properties"
					}
				}
				rendercolor = 
				{
					type = "color255"
					long_name = "FX Color (R G B)"
					description = "The FX color is used by the selected Render Mode."
					default = "255 255 255"
				}
				disablereceiveshadows = 
				{
					type = "boolean"
					long_name = "Disable Receiving Shadows"
					default = "0"
					metadata = 
					{
						group = "Render Properties"
					}
				}
				lightgroup = 
				{
					type = "string"
					long_name = "Light Group"
					description = "Will only be lit by lights affecting this group."
					default = ""
					metadata = 
					{
						group = "Render Properties"
					}
				}
				fademindist = 
				{
					type = "float"
					long_name = "Start Fade Dist"
					description = "Distance at which the overlay starts to fade (<0 = subtract from fademaxdist)."
					default = "-1"
					metadata = 
					{
						group = "Render Properties"
					}
				}
				fademaxdist = 
				{
					type = "float"
					long_name = "End Fade Dist"
					description = "Maximum distance at which the overlay is visible (0 = don't fade out)."
					default = "0"
					metadata = 
					{
						group = "Render Properties"
					}
				}
				fadescale = 
				{
					type = "float"
					long_name = "Fade Scale"
					description = "If you specify a fade in the worldspawn, or if the engine is running under low end/medium end/XBox360, then the engine will forcibly fade out props even if fademindist/fademaxdist isn't specified. This scale factor gives you some control over the fade. Using 0 here turns off the forcible fades. Numbers smaller than 1 cause the prop to fade out at further distances, and greater than 1 cause it to fade out at closer distances."
					default = "1"
					metadata = 
					{
						group = "Render Properties"
					}
				}
				rendertocubemaps = 
				{
					type = "boolean"
					long_name = "Render to Cubemaps"
					description = "If true, this geometry renders into baked cube maps"
					default = "0"
					metadata = 
					{
						group = "Render Properties"
					}
				}
				lightmapstatic = 
				{
					type = "choices"
					long_name = "Lightmap Static"
					description = "How this geometry influences baked lighting."
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "No"
						},
						{
							value = "1"
							caption = "Yes"
						},
						{
							value = "2"
							caption = "Bounce Only"
						},
					]
					metadata = 
					{
						group = "Render Properties"
					}
				}
			}
			inputs = 
			[
				{
					name = "Alpha"
					type = "integer"
					description = "Set the sprite's alpha (0 - 255)."
				},
				{
					name = "Color"
					type = "color255"
					description = "Set the sprite's color (R G B)."
				},
			]
			id = "RenderFields:250820"
		},
