					description = "Scale of the mass load connected to this constraint (1=just the objects directly connected)"
					default = "1"
				}
				initialoffset = 
				{
					type = "float"
					long_name = "Initial Offset"
					description = "Initial offset in the range from -1 to 1 where -1 means spawn at the min limit, 0 means apply no offset, and 1 means spawn at max limit"
					default = "0"
				}
				enablelinearconstraint = 
				{
					type = "boolean"
					long_name = "Enable Linear Constraint"
					default = "1"
				}
				enableangularconstraint = 
				{
					type = "boolean"
					long_name = "Enable Angular Constraint"
					default = "1"
				}
				motorfrequency = 
				{
					type = "float"
					long_name = "Motor frequency"
					description = "Range 0 - 30 (only used when driving the relative offset through the offset input)"
					default = "10"
				}
				motordampingratio = 
				{
					type = "float"
					long_name = "Motor damping ratio"
					description = "Range 0 - 1 (only used when driving the relative offset through the offset input)"
					default = "1"
				}
				motormaxforcemultiplier = 
				{
					type = "float"
					long_name = "Motor max force"
					description = "Measured in multiples (e.g. 10x) of the mass where zero means NO limit (only used when driving the relative offset through the offset input)"
					default = "0"
				}
				useEntityPivot = 
				{
					type = "boolean"
					long_name = "Force Pivot"
					description = "Force joint position as constraint pivot"
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "SetOffset"
					type = "float"
