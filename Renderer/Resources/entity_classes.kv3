					long_name = "Filter Using Probe Exclusion Volumes"
					description = "Don't generate probes inside Probe Exclusion Volumes that have been placed in the map.<br/>(Only used if Generation Type is set to Automatic, Everywhere.)"
					default = "1"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_filter_navmesh = 
				{
					type = "boolean"
					long_name = "Filter Using NavMesh"
					description = "Only generate probes that are near the nav mesh.<br/>(Only used if Generation Type is set to Automatic, Everywhere.)"
					default = "0"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_grid_spacing = 
				{
					type = "float"
					long_name = "Grid Spacing"
					description = "The horizontal distance (in meters) between adjacent probes."
					default = "6"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_height_above_floor = 
				{
					type = "float"
					long_name = "Height Above Floor"
					description = "The height (in meters) above the floor at which probes should be placed.."
					default = "1.5"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_visibility_samples = 
				{
					type = "integer"
					long_name = "Baking Visibilty Samples"
					description = "Number of point samples to use around each probe when testing whether one probe can see another. To determine if two probes are mutually visible, rays are traced from each point sample of the first probe, to every other point sample of the second probe. Increasing this value prevents paths from being considered occluded by small objects, at the cost of increased bake times."
					default = "1"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_visibility_radius = 
				{
					type = "float"
					long_name = "Baking Visibility Radius"
					description = "When testing for mutual visibility between a pair of probes, each probe is treated as a sphere of this radius (in meters), and point samples are generated within this sphere."
					default = "0.0"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_visibility_threshold = 
				{
					type = "float"
					long_name = "Baking Visibility Threshold"
					description = "When tracing rays to test for mutual visibility between a pair of probes, the fraction of rays that are unoccluded must be greater than this threshold for the pair of probes to be considered mutually visible."
					default = "0.1"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_pathing_visibility_pathrange = 
				{
					type = "float"
					long_name = "Baking Path Range"
					description = "If the distance (in meters) between two probes is greater than this value, the probes are considered to not have any path between them. Increasing this value allows sound to propagate over greater distances, at the cost of increased bake times and memory usage."
					default = "100.0"
					metadata = 
					{
						group = "Steam Audio Pathing Settings"
					}
				}
				steamaudio_customdata_rebake_option = 
				{
					type = "choices"
					long_name = "Rebake Option"
					description = "<b>Cleanup</b>: Custom bake is disabled. Baked data will be cleaned up during map compile in Hammer or mapbuilder.<br /><b>Manual</b>: Custom data needs to be baked manually. Baked data is added or updated during map compile in Hammer but untouched by mapbuilder.<br /><b>Auto</b>: Custom data is baked automatically during map compile. Baked data is added or updated during map compile in Hammer or mapbuilder."
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "Cleanup"
						},
						{
							value = "1"
							caption = "Manual"
						},
						{
							value = "2"
							caption = "Auto"
						},
					]
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_generation_type = 
				{
					type = "choices"
					long_name = "Generation Type"
					description = "<b>Automatic, Everywhere</b>: When baking, probes will be generated to cover the entire map.<br/><b>Automatic, Use Probe Generation Volumes</b>: When baking, probes will only be generated within Probe Generation Volumes that have been explicitly placed in the map.<br/><b>Manual</b>: When baking, probes will not be generated. Only probes that have been manually placed in the map will be used."
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "Automatic, Everywhere"
						},
						{
							value = "1"
							caption = "Automatic, Use Probe Generation Volumes"
						},
						{
							value = "2"
							caption = "Manual"
						},
					]
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_filter_volumes = 
				{
					type = "boolean"
					long_name = "Filter Using Probe Exclusion Volumes"
					description = "Don't generate probes inside Probe Exclusion Volumes that have been placed in the map.<br/>(Only used if Generation Type is set to Automatic, Everywhere.)"
					default = "1"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_filter_navmesh = 
				{
					type = "boolean"
					long_name = "Filter Using NavMesh"
					description = "Only generate probes that are near the nav mesh.<br/>(Only used if Generation Type is set to Automatic, Everywhere.)"
					default = "0"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_grid_spacing = 
				{
					type = "float"
					long_name = "Grid Spacing"
					description = "The horizontal distance (in meters) between adjacent probes."
					default = "6"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_height_above_floor = 
				{
					type = "float"
					long_name = "Height Above Floor"
					description = "The height (in meters) above the floor at which probes should be placed.."
					default = "1.5"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_bake_occlusion = 
				{
					type = "boolean"
					long_name = "Bake Occlusion"
					description = "Bake custom occlusion data between probe pairs."
					default = "0"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_bake_dimensions = 
				{
					type = "boolean"
					long_name = "Bake Dimensions"
					description = "Bake occlusion dimensions data (size and inside outside) per probe."
					default = "0"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_bake_materials = 
				{
					type = "boolean"
					long_name = "Bake Materials"
					description = "Bake custom materials data (top 3 nearby materials) per probe."
					default = "0"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_occlusion_reflection = 
				{
					type = "boolean"
					long_name = "Occlusion: Simulate Reflection"
					description = "Simulate reflections when computing baked occlusion."
					default = "0"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_occlusion_reflection_rays = 
				{
					type = "integer"
					long_name = "Occlusion: Reflection Num Rays"
					description = "Number of rays to simulate reflections."
					default = "8192"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
				steamaudio_customdata_occlusion_reflection_bounces = 
				{
					type = "integer"
					long_name = "Occlusion: Reflection Bounces"
					description = "Number of bounces to simulate reflections."
					default = "8"
					metadata = 
					{
						group = "Steam Audio Custom Data Settings"
					}
				}
			}
