					]
				}
				NoInterpolate = 
				{
					type = "boolean"
					long_name = "Disable Client-Side Interpolation"
					default = "0"
					metadata = 
					{
						group = "Misc"
					}
				}
				MoveWithoutPushingBlockers = 
				{
					type = "boolean"
					long_name = "Move Without Pushing Blockers"
					description = "Just moves the entity and anything attached to it, without going the expensive process of finding and pushing potentially blocking brush entities and NPCs. Will still push dynamic physics entities."
					default = "0"
					metadata = 
					{
						group = "Misc"
					}
				}
				speed = 
				{
					type = "integer"
					long_name = "Speed"
					description = "The speed that the brush moves, in inches per second."
					default = "100"
				}
				movedistance = 
				{
					type = "float"
					long_name = "Move Distance"
					description = "The distance from the starting point that the brush should move, in inches."
					default = "100"
				}
				blockdamage = 
				{
					type = "float"
					long_name = "Block Damage"
					description = "The amount of damage to do to any entity that blocks the brushes, per frame."
					default = "0"
				}
				startsound = 
				{
					type = "sound"
					long_name = "Sound played when the brush starts moving."
				}
				stopsound = 
				{
					type = "sound"
					long_name = "Sound played when the brush stops moving."
				}
				CreateNavObstacle = 
				{
					type = "boolean"
					long_name = "Create Nav Obstacle"
					description = "Create a navigation obstacle to assist NPC pathfinding"
					default = "0"
				}
				CreateMovableNavMesh = 
				{
					type = "boolean"
					long_name = "Create Movable Nav Mesh"
					description = "Create a navigation mesh that moves with the brush."
					default = "0"
				}
				AllowMovableNavMeshDockingOnEntireEntity = 
				{
					type = "boolean"
					long_name = "Movable Nav Mesh, Allow Docking on Full Entity"
					description = "If this entity creates a movable nav mesh, then allow docking test across the entire entity."
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "Open"
					type = "void"
					description = "Move the brush to the end position (starting position + (move direction * move distance))."
				},
				{
					name = "Close"
					type = "void"
					description = "Move the brush to the starting position."
				},
				{
					name = "SetPosition"
					type = "string"
					description = "Move the brush to a specific position between 0.0 and 1.0, where 0 is the starting position and 1 is the starting position + (move direction * move distance)."
				},
				{
					name = "ResetPosition"
					type = "float"
					description = "Set a new start position for our current location."
				},
				{
					name = "SetSpeed"
					type = "float"
					description = "Set the speed and update immediately."
				},
				{
					name = "TeleportToTarget"
					type = "targetdestination"
					description = "Teleport to this entity's origin."
				},
				{
					name = "SetMoveDistanceFromStart"
					type = "float"
					description = "Update the end position to be this distance from the start position."
				},
				{
					name = "SetMoveDistanceFromEnd"
					type = "float"
					description = "Update the start position to be this distance from the end position."
				},
			]
			outputs = 
			[
				{
					name = "OnFullyOpen"
					type = "void"
					description = "Fired when the brush reaches the end position (starting position + (move direction * move distance))."
				},
				{
					name = "OnFullyClosed"
					type = "void"
					description = "Fired when the brush reaches the starting position."
				},
			]
