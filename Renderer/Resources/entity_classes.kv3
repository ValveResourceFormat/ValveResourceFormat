				damagemodel = 
				{
					type = "intchoices"
					long_name = "Damage Model"
					description = "How damage is dealt. Normal always does the specified amount of damage each half second. Doubling starts with the specified amount and doubles it each time it hurts the toucher. Forgiveness means that if the toucher gets out of the trigger the damage will reset to the specified value. Good for making triggers that are deadly over time without having to cause massive damage on each touch."
					default = "0"
					choices = 
					[
						{
							value = "0"
							caption = "Normal"
						},
						{
							value = "1"
							caption = "Doubling w/forgiveness"
						},
					]
				}
				forgivedelay = 
				{
					type = "float"
					long_name = "Forgiveness delay"
					description = "When doubling with forgiveness, how many seconds the trigger must go without hurting anything before the damage is reset."
					default = "3"
				}
				nodmgforce = 
				{
					type = "boolean"
					long_name = "Zero Damage Force"
					description = "Should the damaged entity receive no physics force from this trigger."
					default = "0"
				}
				damageforce = 
				{
					type = "vector"
					long_name = "Damage Force Override"
				}
				thinkalways = 
				{
					type = "boolean"
					long_name = "Always think every frame"
					description = "Normally triggers think every half second, in some cases you may need to request it to damage every frame.  This is expensive!"
					default = "0"
				}
			}
			inputs = 
