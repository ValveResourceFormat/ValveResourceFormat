		{
			name = "phys_slideconstraint"
			kind = "point"
			description = "A constraint that constrains an entity along a line segment."
			color = [ 220, 30, 220 ]
			helpers = 
			[
				{
					name = "editormodel"
					arguments = 
					[
						"models/editor/axis_helper.vmdl",
					]
				},
				{
					name = "vecline"
					arguments = 
					[
						"slideaxis",
					]
				},
			]
			bases = 
			[
				"TwoObjectPhysics:250820",
				"ConstraintSoundInfo",
			]
			keys = 
			{
				spawnflags = 
				{
					type = "flags"
					default = "1"
					choices = 
					[
						{
							value = "1"
							caption = "No Collision until break"
							default = true
						},
						{
							value = "2"
							caption = "Limit Endpoints"
						},
						{
							value = "4"
							caption = "Start inactive"
						},
						{
							value = "8"
							caption = "Change mass to keep stable attachment to world"
						},
						{
							value = "16"
							caption = "Do not connect entities until turned on"
						},
					]
				}
				slideaxis = 
				{
					type = "vecline"
					long_name = "Sliding Axis"
				}
				slidefriction = 
				{
					type = "float"
					long_name = "Set motor friction, 0 = no friction, 1 = friction that is about enough to counter gravity"
				}
				SystemLoadScale = 
				{
					type = "float"
					long_name = "Load Scale"
					description = "Scale of the mass load connected to this constraint (1=just the objects directly connected)"
					default = "1"
				}
				initialoffset = 
				{
					type = "float"
					long_name = "Initial Offset"
					description = "Initial offset in the range from -1 to 1 where -1 means spawn at the min limit, 0 means apply no offset, and 1 means spawn at max limit"
					default = "0"
				}
				enablelinearconstraint = 
				{
					type = "boolean"
					long_name = "Enable Linear Constraint"
					default = "1"
				}
				enableangularconstraint = 
				{
					type = "boolean"
					long_name = "Enable Angular Constraint"
					default = "1"
				}
				motorfrequency = 
				{
					type = "float"
					long_name = "Motor frequency"
					description = "Range 0 - 30 (only used when driving the relative offset through the offset input)"
					default = "10"
				}
				motordampingratio = 
				{
					type = "float"
					long_name = "Motor damping ratio"
					description = "Range 0 - 1 (only used when driving the relative offset through the offset input)"
					default = "1"
				}
				motormaxforcemultiplier = 
				{
					type = "float"
					long_name = "Motor max force"
					description = "Measured in multiples (e.g. 10x) of the mass where zero means NO limit (only used when driving the relative offset through the offset input)"
					default = "0"
				}
			}
			inputs = 
			[
				{
					name = "SetOffset"
					type = "float"
					description = "Normalized input to drive along the slide axis. E.g 0 = min limit and 1 = max limit"
				},
				{
					name = "SetVelocity"
					type = "float"
					description = "Set linear velocity along the constraint"
				},
				{
					name = "SetSlideFriction"
					type = "float"
					description = "Set motor friction, 0 = no friction, 1 = friction that is about enough to counter gravity"
				},
			]
			id = "phys_slideconstraint:250820"
		},
