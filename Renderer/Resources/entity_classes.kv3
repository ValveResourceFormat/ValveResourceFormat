							value = "0"
							caption = "A"
						},
						{
							value = "1"
							caption = "B"
						},
					]
				}
				bomb_damage_power = 
				{
					type = "float"
					long_name = "Bomb Power"
					default = "3000"
				}
			}
			outputs = 
			[
				{
					name = "BombExplode"
					type = "void"
					description = "Fires when C4 explodes"
				},
				{
					name = "BombPlanted"
					type = "void"
					description = "Fires when a C4 is planted"
				},
				{
					name = "BombDefused"
					type = "void"
					description = "Fires when a C4 is defused"
				},
			]
		},
