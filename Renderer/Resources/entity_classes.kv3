					name = "OnTouching"
					type = "void"
					description = "Fired when the TestTouch input is true (something is touching the trigger.)"
				},
				{
					name = "OnNotTouching"
					type = "void"
					description = "Fired when the TestTouch input is not true (nothing is touching the trigger.)"
				},
			]
		},
